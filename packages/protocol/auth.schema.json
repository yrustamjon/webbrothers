{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bmp:protocol:auth:v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "device_id",
        "nonce",
        "expires_at"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "AUTH_CHALLENGE"
        },
        "device_id": {
          "type": "string"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "device_id",
        "nonce",
        "signature"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "AUTH_PROOF"
        },
        "device_id": {
          "type": "string"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "signature": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    }
  ]
}
